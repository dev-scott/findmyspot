{
  "name": "findmyspot",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "libs/*"
    ],
    "nohoist": [
      "**/@nestjs",
      "**/@nestjs/**"
    ]
  },
  "scripts": {
    "format": "prettier \"{app,libs}/**/*.{ts,tsx,js,json}\" --ignore-path .gitignore",
    "format:check": "yarn format --check",
    "format:write": "yarn format --write",
    "tsc": "yarn nx run-many -t tsc",
    "lint": "yarn nx run-many -t lint",
    "build": "yarn nx run-many -t build",
    "validate": "yarn format:write && yarn tsc && yarn lint && yarn build",
    "prepare": "husky install"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "nx": "22.5.4",
    "prettier": "^2.3.2",
    "typescript": "^5.4.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "rxjs": "^7.8.2"
  }
}
